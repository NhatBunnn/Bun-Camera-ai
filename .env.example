# ==========================================
# CẤU HÌNH DỰ ÁN BUN CAMERA AI (.env.example)
# ==========================================

# 1. Google Gemini API Key
# Lấy key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini sử dụng (mặc định khuyến nghị: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 2. Camera RTSP Stream URL
# Định dạng chuẩn cho camera IP (ví dụ camera Tiandy TC-H322N):
# rtsp://[Username]:[Password]@[IP_Address]:[Port]/[Channel]/[Stream]
# - Channel: 1 (kênh camera chính)
# - Stream: 1 (luồng chính chất lượng cao) hoặc 2 (luồng phụ mượt mà)
CAMERA_RTSP_URL=rtsp://Admin:MAT_KHAU@192.168.0.101:554/1/1
